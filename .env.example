# Copy this file to `.env` and fill in the values from your Lovable Cloud / Supabase project.
# Project Settings → API in the Supabase dashboard.

# Client-side (exposed to browser by Vite — only use publishable keys here)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"

# Server-side (used by TanStack server functions during SSR / dev)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-only secrets (NEVER prefix with VITE_) — required for admin queries
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Razorpay (for payments) — get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
